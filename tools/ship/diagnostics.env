# DiagnosticKit configuration for "Spectr Diagnostics". Copy to the
# DiagnosticKit checkout as .env, then Scripts/build_app.sh release.
# Local-ZIP mode only: no GitHub token belongs in this file.
APP_NAME="Spectr Diagnostics"
APP_IDENTIFIER="com.pulp.spectr.diagnostics"
APP_VERSION="1.0.0"
GITHUB_REPO=""
GITHUB_PAT=""
SUPPORT_EMAIL=""
PRODUCT_NAME="Spectr"
PRODUCT_WEBSITE=""
PLUGIN_NAME="Spectr"
PLUGIN_BUNDLE_ID="com.pulp.spectr"
PLUGIN_MANUFACTURER="Pulp"
CHECK_AU=true
CHECK_VST3=true
CHECK_CLAP=true
CHECK_STANDALONE=true
AU_TYPE="aufx"
AU_SUBTYPE="Spec"
AU_MANUFACTURER="Pulp"
PULP_MODEL_PATH=""
